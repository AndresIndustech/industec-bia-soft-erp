# Los informes de OT llevan nombre, correo y firma manuscrita de empleados de
# Grupo KFC. NUNCA se sirven como archivo: el único camino es pdf.php, que
# comprueba sesión y alcance, o un enlace firmado con caducidad.
#
# Hasta el 2026-09-10 esta protección existía solo en el servidor.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
