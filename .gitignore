# El repositorio cubre TODO el proyecto, no solo el código: así quedan versionados
# también CLAUDE.md, ESTADO.md, PLAN_INDUSTEC.md y las skills, que son los documentos
# desde los que cualquier conversación retoma el trabajo.

# --- Carpetas sincronizadas con Google Drive: NO se versionan --------------
# Drive ya las respalda, pesan más de 1,5 GB y su contenido lo pone la
# administración, no nosotros. Versionarlas duplicaría el respaldo y llenaría
# el historial de binarios.
# Se ignora el CONTENIDO (con /*), no la carpeta, para poder rescatar su LEEME:
# git no puede reincluir un archivo si su carpeta entera esta excluida.
ENTRADAS IA/*
!ENTRADAS IA/LEEME.md
SALIDAS IA/*
!SALIDAS IA/LEEME.md

# --- Entorno y credenciales -----------------------------------------------
desarrollo/agentes/.venv/
desarrollo/agentes/config/.env
desarrollo/datos/

# --- Basura de ejecución ---------------------------------------------------
__pycache__/
*.pyc
*.log
node_modules/

# --- Documentos del corpus -------------------------------------------------
# El corpus vive en D:\RESPALDOS, fuera del proyecto. Esta regla es una red de
# seguridad por si algún script deja un PDF suelto dentro del repositorio.
*.pdf
*.xlsx
*.csv

# Claves SSH y secretos del hosting. La privada de Hostinger vive en
# %USERPROFILE%\.ssh y no tiene por que acercarse al repositorio, pero si
# alguien la copia aqui por comodidad, que git no la deje entrar.
*.pem
*.key
id_ed25519*
id_rsa*
industec_hostinger*
secretos.ini

# Credenciales de la app de gestion.
# La regla apuntaba a app/nucleo/config.php, que NO existe: el archivo vive en
# app/publico/nucleo/. `git check-ignore` decia OK porque la ruta calzaba con el
# patron, no porque protegiera al archivo real. Se salvo de que nadie hubiera
# hecho `git add` de esa carpeta todavia. Se cubre el nombre en cualquier nivel.
**/nucleo/config.php

# Padron de personal: nombres de los 19 empleados vigentes. Lo genera
# t2_8_padron_tecnicos.py y se sube a mano a nucleo/ en el servidor. No viaja
# en el repositorio ni en un paquete.
desarrollo/sistema_ots/app/publico/nucleo/padron.json

# Llave SSH de despliegue a Hostinger. La privada no sale de esta estacion.
desarrollo/agentes/config/clave_hostinger
desarrollo/agentes/config/clave_hostinger.pub

# Logs del vigilante del buzon: se rotan solos por fecha, no van al repositorio.
desarrollo/agentes/logs/
