{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/desarrollo/agentes/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/desarrollo/agentes/scripts/guardar_sesion.py\" --silencioso 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Guardando el trabajo en curso..."
          }
        ]
      }
    ]
  }
}
